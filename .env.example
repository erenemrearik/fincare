# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# --- Database (PostgreSQL) ---
# Pooled connection used by the app at runtime
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@localhost:5432/fincare?schema=public"
# Direct connection used by Prisma Migrate
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@localhost:5432/fincare?schema=public"

# --- Authentication (Clerk) — https://dashboard.clerk.com ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# --- AI insights (Google Gemini) — https://aistudio.google.com/app/apikey ---
# Optional. Without a key the reports page falls back to rule-based insights.
GEMINI_API_KEY=""
